{
  "name": "dartwic-example-device-plugin",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/settings.test.mjs scripts/package-metadata.test.mjs scripts/device-bindings.test.mjs scripts/plugin-release.test.mjs",
    "build": "node build.mjs",
    "build:interface": "node build.mjs",
    "verify": "node ./scripts/plugin-verify.mjs --source-only",
    "verify:package": "node ./scripts/plugin-verify.mjs",
    "verify:sdk": "node ./scripts/plugin-sdk-lock.mjs",
    "preversion": "node ./scripts/plugin-version.mjs --validate",
    "version": "node ./scripts/plugin-version.mjs",
    "package": "node ./scripts/plugin-package.mjs",
    "package-debug": "node ./scripts/plugin-package.mjs",
    "deploy": "node ./scripts/plugin-deploy.mjs",
    "deploy-debug": "node ./scripts/plugin-deploy.mjs --debug",
    "deploy:engine-debug": "node ./scripts/plugin-deploy.mjs --engine-debug",
    "deploy:interface": "node ./scripts/plugin-deploy.mjs --interface"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postcss": "^8.4.48",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  }
}
